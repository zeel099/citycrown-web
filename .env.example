# Postgres connection
DATABASE_URL="postgresql://bitc:bitc@localhost:5432/bitc"

# Public base URL, used for payment return links
APP_URL="http://localhost:3000"

# Payment provider: "auto" picks Razorpay for INR and Stripe for other currencies.
# "mock" confirms payments locally without any gateway (development only).
PAYMENT_PROVIDER="mock"

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Basic auth for /admin
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me"

# Google Places API key for the ratings on board cards (FR-BRD-09). Optional: without it
# cards show no rating. Refresh with: npx tsx scripts/refresh-google-ratings.ts
GOOGLE_PLACES_API_KEY=""

# Email (receipts with the invoice PDF, outbid alerts, verification results). Set up one of:
# - SMTP, e.g. Gmail: turn on 2-Step Verification for the Google account, create an app password at
#   https://myaccount.google.com/apppasswords and use it as SMTP_PASS (the normal password won't work).
#   Gmail caps how much you can send a day, so for a busy site use an email service instead.
#   Other providers work the same way with their SMTP details (port 465, or 587 with STARTTLS).
# - Resend: RESEND_API_KEY, with MAIL_FROM on a domain verified in Resend. Used instead of SMTP when set.
# Without either, development keeps every email at /dev/outbox and production sends nothing.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
# Sender. Defaults to "Best in the City <SMTP_USER>"; Gmail only sends from SMTP_USER or an alias set up in Gmail.
MAIL_FROM=""
MAIL_REPLY_TO=""

# Seller details printed on GST tax invoices (/receipts/...). Shown as "not set" until filled.
SELLER_NAME=""
SELLER_GSTIN=""
SELLER_ADDRESS=""

# Maps. Address search uses OpenStreetMap through Photon (free, fair use); set GEOCODER_URL to use
# your own Photon server. Map tiles come from OpenStreetMap by default, which is fine for light
# traffic; for a busy site point NEXT_PUBLIC_MAP_TILES at a tile provider (e.g. MapTiler).
GEOCODER_URL=""
NEXT_PUBLIC_MAP_TILES=""
NEXT_PUBLIC_MAP_ATTRIBUTION=""

# About page: when the site went live, as an ISO date (e.g. 2026-11-10T18:00:00+05:30).
# Without it the About page uses the time of the first confirmed bid.
SITE_LAUNCHED_AT=""
